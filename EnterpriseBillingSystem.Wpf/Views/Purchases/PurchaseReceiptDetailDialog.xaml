<Window x:Class="EnterpriseBillingSystem.Wpf.Views.Purchases.PurchaseReceiptDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Detalle de Recepción de Compra" Height="750" Width="1100" MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header Info -->
            <RowDefinition Height="Auto" />
            <!-- 1: Details DataGrid Table -->
            <RowDefinition Height="*" MinHeight="250" />
            <!-- 2: Notes & Summary Totals -->
            <RowDefinition Height="Auto" />
            <!-- 3: Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Recepción " FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="{Binding ReceiptNumber}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Proveedor: " FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Text="{Binding SupplierName}" Margin="0,0,12,0" FontWeight="Bold" Foreground="#1E293B" />
                    
                    <TextBlock Text="Bodega Destino: " FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Text="{Binding WarehouseName}" Margin="0,0,12,0" FontWeight="Bold" Foreground="#1565C0" />

                    <TextBlock Text="Doc. Referencia: " FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Text="{Binding ReferenceDocument}" Margin="0,0,12,0" FontWeight="Bold" Foreground="#0F172A" />

                    <TextBlock Text="Fecha Ingreso: " FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Text="{Binding ReceiptDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontWeight="Bold" />
                </WrapPanel>
            </StackPanel>

            <!-- Status Badge -->
            <Border Grid.Column="1" CornerRadius="4" Padding="12,6" Background="#E8F5E9" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="RECIBIDO" FontWeight="Bold" FontSize="13" Foreground="#2E7D32" />
            </Border>
        </Grid>

        <!-- DataGrid Items -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1">
            <DataGrid ItemsSource="{Binding Details}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Código" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProductCode}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Descripción del Producto" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="U.M." Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UnitOfMeasure}" VerticalAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Cant. Recibida" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N2}'}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#1E293B" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Costo Unit. ($)" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:C2}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Subtotal ($)" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:C2}'}" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- Bottom Notes and Totals Row -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Notes -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Notas / Observaciones del Ingreso" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" Foreground="#334155" />
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White" Padding="8,6">
                    <TextBox Text="{Binding Notes}" Style="{x:Null}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" 
                              VerticalScrollBarVisibility="Auto" Height="50" 
                              BorderThickness="0" VerticalContentAlignment="Top" Background="Transparent" />
                </Border>
            </StackPanel>

            <!-- Totals Card -->
            <materialDesign:Card Grid.Column="1" Padding="14,10" materialDesign:ElevationAssist.Elevation="Dp1" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Piezas Recibidas:" VerticalAlignment="Center" Margin="0,3" Opacity="0.8" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalQuantityDisplay}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,3" Foreground="#0F172A" />

                    <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="MONTO TOTAL COSTO:" FontSize="15" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalCostDisplay}" FontSize="18" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MaterialDesignFlatButton}" Click="CloseButton_Click" Content="Cerrar" />
        </StackPanel>
    </Grid>
</Window>
