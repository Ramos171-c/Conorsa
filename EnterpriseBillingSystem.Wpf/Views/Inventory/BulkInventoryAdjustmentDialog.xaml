<Window x:Class="EnterpriseBillingSystem.Wpf.Views.Inventory.BulkInventoryAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Saneo Masivo de Inventario" Height="680" Width="1000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Border CornerRadius="12" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#44000000" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="📋 Saneo e Inventario Físico Masivo" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="Ingrese los saldos físicos reales contados en bodega para actualizar el inventario masivamente." Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.7" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Padding="4" Width="32" Height="32" Click="CloseButton_Click" ToolTip="Cerrar">
                    <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </Button>
            </Grid>

            <!-- Search & Filters Panel -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSearch" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         materialDesign:HintAssist.Hint="Buscar por Código o Nombre de Producto..." 
                         TextChanged="TxtSearch_TextChanged" Height="42" Padding="10,8" />
                <TextBlock Grid.Column="1" x:Name="TxtSummary" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="13" />
            </Grid>

            <!-- Main Editable DataGrid -->
            <materialDesign:Card Grid.Row="2" materialDesign:ElevationAssist.Elevation="Dp1" Margin="0,0,0,16">
                <DataGrid x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding ProductInternalCode}" IsReadOnly="True" Width="110" />
                        
                        <DataGridTemplateColumn Header="Producto / Descripción" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="U.M." Binding="{Binding UnitOfMeasure}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource CenterAlignedColumnStyle}" />
                        
                        <DataGridTextColumn Header="Stock Sistema" Binding="{Binding SystemStock, StringFormat='{}{0:N2}'}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource RightAlignedColumnStyle}" />

                        <DataGridTemplateColumn Header="Stock Físico Real en Bodega" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding NewStockText, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                             Height="36" Padding="8,4" FontWeight="Bold" FontSize="14" HorizontalContentAlignment="Right"
                                             Background="#F3E8FF" BorderBrush="{DynamicResource PrimaryHueMidBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Bottom Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="* Los saldos modificados generarán automáticamente un movimiento Kardex de Ajuste por Saneo." 
                           VerticalAlignment="Center" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource MaterialDesignFlatButton}" Click="BtnCancel_Click" Margin="0,0,12,0" Width="120" Height="40" />
                    <Button x:Name="BtnSave" Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnSave_Click" Width="260" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveCheck" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="💾 Guardar Conteo Físico Real" VerticalAlignment="Center" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
