<Window x:Class="EnterpriseBillingSystem.Wpf.Views.Customers.CustomerEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:EnterpriseBillingSystem.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="600" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F8FAFC">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Complete la informacion del cliente" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <materialDesign:Card UniformCornerRadius="10" Background="White" materialDesign:ElevationAssist.Elevation="Dp1" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Informacion General" FontWeight="Bold" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox materialDesign:HintAssist.Hint="Nombre del Cliente *" materialDesign:HintAssist.FloatingScale="0.85" materialDesign:TextFieldAssist.LeadingIcon="BadgeOutline" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="0,0,0,12"/>
                        <ComboBox materialDesign:HintAssist.Hint="Ruta Asignada" materialDesign:TextFieldAssist.LeadingIcon="TruckDeliveryOutline" Style="{StaticResource MaterialDesignOutlinedComboBox}" ItemsSource="{Binding Routes}" SelectedValue="{Binding SelectedRouteId}" SelectedValuePath="Id" DisplayMemberPath="Name" IsEditable="False" FontSize="13" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="10" Background="White" materialDesign:ElevationAssist.Elevation="Dp1" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="CardAccountMailOutline" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Direccion y Contacto" FontWeight="Bold" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox materialDesign:HintAssist.Hint="Telefono Principal" materialDesign:TextFieldAssist.LeadingIcon="PhoneOutline" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="Correo Electronico" materialDesign:TextFieldAssist.LeadingIcon="EmailOutline" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="Direccion" materialDesign:TextFieldAssist.LeadingIcon="MapMarkerOutline" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="Barrio / Colonia" materialDesign:TextFieldAssist.LeadingIcon="HomeCityOutline" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Neighborhood, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Ciudad" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" FontSize="13" />
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Pais" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" FontSize="13" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource MaterialDesignFlatButton}" Content="Cancelar" Click="CancelButton_Click" Foreground="#64748B" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" />
            <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#0F172A" BorderBrush="#0F172A" Foreground="White" Height="42" Padding="24,0" materialDesign:ButtonAssist.CornerRadius="8" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}">
                <Grid>
                    <TextBlock Text="GUARDAR CLIENTE" FontWeight="Bold" FontSize="13" Visibility="{Binding IsSaving, Converter={StaticResource InverseBoolToVis}}" />
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="20" Height="20" Foreground="White" Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
        </DockPanel>
    </Grid>
</Window>
