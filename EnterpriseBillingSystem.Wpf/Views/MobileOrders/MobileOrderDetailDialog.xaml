<Window x:Class="EnterpriseBillingSystem.Wpf.Views.MobileOrders.MobileOrderDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:EnterpriseBillingSystem.Wpf.Converters"
        mc:Ignorable="d"
        Title="Detalle del Pedido" Height="820" Width="1200" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header Info -->
            <RowDefinition Height="Auto" />
            <!-- 1: Warning / Info Banners -->
            <RowDefinition Height="Auto" />
            <!-- 2: DataGrid (Products List) -->
            <RowDefinition Height="*" MinHeight="260" />
            <!-- 3: Notes & Totals Summary Row -->
            <RowDefinition Height="Auto" />
            <!-- 4: Footer Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Pedido " FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="{Binding OrderNumber}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>
                
                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Cliente: " FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Text="{Binding CustomerName}" Margin="0,0,8,0" FontWeight="Bold" />
                    <TextBlock Text="(" Opacity="0.6" />
                    <TextBlock Text="{Binding CustomerCode}" Opacity="0.6" />
                    <TextBlock Text=")  |  " Opacity="0.6" />
                    
                    <TextBlock Text="Fecha: " FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Text="{Binding OrderDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontWeight="Bold" />
                </WrapPanel>
            </StackPanel>

            <!-- Status Badge -->
            <Border Grid.Column="1" CornerRadius="4" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Solicitud">
                                <Setter Property="Background" Value="#FFF3E0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Recibido">
                                <Setter Property="Background" Value="#E8F5E9" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Anulado">
                                <Setter Property="Background" Value="#FFEBEE" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="EnProceso">
                                <Setter Property="Background" Value="#E3F2FD" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="EnCamino">
                                <Setter Property="Background" Value="#EDE7F6" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Completado">
                                <Setter Property="Background" Value="#E0F2F1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="SolicitudAnulacion">
                                <Setter Property="Background" Value="#FFEBEE" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontWeight="Bold" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Solicitud">
                                    <Setter Property="Text" Value="SOLICITUD" />
                                    <Setter Property="Foreground" Value="#E65100" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Recibido">
                                    <Setter Property="Text" Value="RECIBIDO" />
                                    <Setter Property="Foreground" Value="#2E7D32" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Anulado">
                                    <Setter Property="Text" Value="ANULADO" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="EnProceso">
                                    <Setter Property="Text" Value="EN PROCESO" />
                                    <Setter Property="Foreground" Value="#1565C0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="EnCamino">
                                    <Setter Property="Text" Value="EN CAMINO" />
                                    <Setter Property="Foreground" Value="#6A1B9A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Completado">
                                    <Setter Property="Text" Value="COMPLETADO" />
                                    <Setter Property="Foreground" Value="#00695C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="SolicitudAnulacion">
                                    <Setter Property="Text" Value="SOLICITUD ANULACIÓN" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Row 1: Banners -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <!-- Cancellation Request Warning Banner -->
            <materialDesign:Card Background="#FFEBEE" Padding="12,8" Margin="0,0,0,6"
                                 Visibility="{Binding IsCancellationRequested, Converter={StaticResource BoolToVis}}" 
                                 materialDesign:ElevationAssist.Elevation="Dp0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C62828" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="¡EL VENDEDOR SOLICITÓ ANULAR ESTE PEDIDO!" FontSize="12" FontWeight="Bold" Foreground="#C62828" />
                        <TextBlock Text="{Binding CancellationReason, StringFormat='Motivo indicado: {0}'}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Partial Delivery & Invoicing Info Banner -->
            <materialDesign:Card Padding="12,6" Background="#EFF6FF" materialDesign:ElevationAssist.Elevation="Dp0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Information" Foreground="#2563EB" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Ajuste la 'Cant. Entregada' o 'No Vino / Faltante'. La factura se emitirá únicamente por la Cantidad Entregada." 
                               FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>

        <!-- Row 2: Product Lines DataGrid -->
        <materialDesign:Card Grid.Row="2" Margin="0,0,0,12" materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <ProgressBar IsIndeterminate="True" 
                             Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" 
                             VerticalAlignment="Top" Height="4" Panel.ZIndex="10" Foreground="#4F46E5" />

                <DataGrid ItemsSource="{Binding Details}" AutoGenerateColumns="False" IsReadOnly="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- Código -->
                        <DataGridTemplateColumn Header="Código" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductCode}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="6,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Descripción / Nombre del Producto -->
                        <DataGridTemplateColumn Header="Descripción del Producto" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding DisplayText}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- U.M. -->
                        <DataGridTemplateColumn Header="U.M." Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitOfMeasure}" VerticalAlignment="Center" Margin="6,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Cant. Pedida -->
                        <DataGridTemplateColumn Header="Cant. Pedida" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" 
                                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="2,0" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Cant. Real Entregada -->
                        <DataGridTemplateColumn Header="Cant. Entregada" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DeliveredQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" 
                                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="2,0" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cant. Faltante / No Vino -->
                        <DataGridTemplateColumn Header="No Vino / Faltante" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEF2F2" CornerRadius="3" Padding="4,2">
                                        <TextBox Text="{Binding MissingQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" 
                                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center" 
                                                 Foreground="#DC2626" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Motivo / Observación Faltante -->
                        <DataGridTemplateColumn Header="Motivo Faltante" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding MissingReason, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="Ej: Sin stock / Daño" 
                                             VerticalContentAlignment="Center" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Precio Unit. -->
                        <DataGridTemplateColumn Header="Precio Unit." Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" 
                                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="2,0" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Neto Efectivo -->
                        <DataGridTemplateColumn Header="Neto Efectivo" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EffectiveNetAmount, StringFormat='{}{0:C2}'}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Delete Item Button Column -->
                        <DataGridTemplateColumn Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RemoveDetailItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}" 
                                            ToolTip="Eliminar este producto del pedido" 
                                            Style="{StaticResource MaterialDesignIconButton}" 
                                            Width="28" Height="28" Padding="0">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#DC2626" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- Row 3: Bottom Notes and Totals Row -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Notes and Observations -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Seller Notes -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Notas / Observaciones del Vendedor" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" Foreground="#334155" />
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White" Padding="6,4">
                        <TextBox Text="{Binding Notes}" Style="{x:Null}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" 
                                  VerticalScrollBarVisibility="Auto" Height="45" 
                                  BorderThickness="0" VerticalContentAlignment="Top" Background="Transparent" />
                    </Border>
                </StackPanel>

                <!-- Dispatcher Notes -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Observaciones de Entrega / Despacho / Faltantes" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" Foreground="#334155" />
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White" Padding="6,4">
                        <TextBox Text="{Binding DispatcherNotes, UpdateSourceTrigger=PropertyChanged}" Style="{x:Null}" AcceptsReturn="True" TextWrapping="Wrap" 
                                  VerticalScrollBarVisibility="Auto" Height="45" 
                                  BorderThickness="0" VerticalContentAlignment="Top" Background="Transparent" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Totals Card -->
            <materialDesign:Card Grid.Column="1" Padding="14,10" materialDesign:ElevationAssist.Elevation="Dp1" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Total Solicitado Original -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Pedido Original:" VerticalAlignment="Center" Margin="0,2" Opacity="0.7" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:C2}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2" Opacity="0.7" />

                    <!-- Piezas Faltantes -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Piezas Faltantes (No Vino):" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalMissingQuantityDisplay}" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center" Margin="0,2" />

                    <!-- Impuestos -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Impuestos (IVA):" VerticalAlignment="Center" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxAmount, StringFormat={}{0:C2}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2" />

                    <!-- Divider -->
                    <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,4" />

                    <!-- Total Neto Efectivo a Cobrar -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="TOTAL NETO A COBRAR:" FontSize="15" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EffectiveTotalAmount, StringFormat={}{0:C2}}" FontSize="17" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" Margin="0,2,0,0" />
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Row 4: Footer Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Grouped Actions (Confirm, Cancel, Return Partial, Return Total) -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                <!-- Save Order Edits Button (Blue) -->
                <Button Command="{Binding SaveOrderChangesCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#2563EB" BorderBrush="#2563EB" 
                        Visibility="{Binding IsOrderEdited, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Guardar Cambios" VerticalAlignment="Center" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <!-- Cancel / Reject Button (Red) -->
                <Button Command="{Binding CancelOrderCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#C62828" BorderBrush="#C62828" 
                        IsEnabled="{Binding IsActionEnabled}"
                        Visibility="{Binding IsActionEnabled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Anular Pedido" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Confirm Button (Green) -->
                <Button Command="{Binding ConfirmOrderCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#2E7D32" BorderBrush="#2E7D32" 
                        IsEnabled="{Binding IsActionEnabled}"
                        Visibility="{Binding IsActionEnabled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Confirmar Pedido" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Approve Cancellation Button (Only visible if SolicitudAnulacion) -->
                <Button Command="{Binding ApproveCancellationCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#2E7D32" BorderBrush="#2E7D32" 
                        Visibility="{Binding IsCancellationRequested, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Aprobar Anulación" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Reject Cancellation Button (Only visible if SolicitudAnulacion) -->
                <Button Command="{Binding RejectCancellationCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#C62828" BorderBrush="#C62828" 
                        Visibility="{Binding IsCancellationRequested, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Rechazar Anulación" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Devolución Parcial (Blue) -->
                <Button Command="{Binding ReturnPartialCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#1976D2" BorderBrush="#1976D2" 
                        IsEnabled="{Binding IsReturnEnabled}"
                        Visibility="{Binding IsReturnEnabled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyboardReturn" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Devolución Parcial" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Devolución Total (Deep Orange) -->
                <Button Command="{Binding ReturnTotalCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#E65100" BorderBrush="#E65100" 
                        IsEnabled="{Binding IsReturnEnabled}"
                        Visibility="{Binding IsReturnEnabled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Devolución Total" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status Update Panel & Save Changes -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding SaveOrderChangesCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#2E7D32" BorderBrush="#2E7D32"
                        Margin="0,0,12,0"
                        ToolTip="Guarda los ajustes de cantidades entregadas y faltantes en la factura">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Guardar Cambios" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" Visibility="{Binding IsStatusChangeVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Estado: " VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                    <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding SelectedNewStatus}" 
                              Width="120" Margin="0,0,6,0" />
                    <Button Command="{Binding UpdateStatusCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Content="Actualizar" />
                </StackPanel>
            </StackPanel>

            <!-- Close Button & Print Ticket -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Command="{Binding PrintDeliveryTicketCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#673AB7" BorderBrush="#673AB7"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Imprimir Entrega" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                
                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                        Click="CloseButton_Click" 
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"
                        Content="Cerrar" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
