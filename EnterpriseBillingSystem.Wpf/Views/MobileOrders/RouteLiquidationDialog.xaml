<UserControl x:Class="EnterpriseBillingSystem.Wpf.Views.MobileOrders.RouteLiquidationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100" Background="White" Width="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="TruckCheck" Width="32" Height="32" Foreground="#8E24AA" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Registre la devolución de mercadería al almacén y liquide la carga entregada." 
                       Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.7" Margin="44,4,0,0" />
        </StackPanel>

        <!-- Summary KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Margin="0,0,6,0" Padding="12" Background="#1565C0" Foreground="White" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="TOTAL ENVIADO" FontSize="11" FontWeight="SemiBold" Opacity="0.9" />
                    <TextBlock Text="{Binding TotalSent, StringFormat='{}{0:N2}'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1" Margin="6,0,6,0" Padding="12" Background="#D32F2F" Foreground="White" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="TOTAL RETORNADO" FontSize="11" FontWeight="SemiBold" Opacity="0.9" />
                    <TextBlock Text="{Binding TotalReturned, StringFormat='{}{0:N2}'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Margin="6,0,6,0" Padding="12" Background="#2E7D32" Foreground="White" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="TOTAL VENDIDO" FontSize="11" FontWeight="SemiBold" Opacity="0.9" />
                    <TextBlock Text="{Binding TotalSold, StringFormat='{}{0:N2}'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="3" Margin="6,0,0,0" Padding="12" Background="#6A1B9A" Foreground="White" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="MONTO VENDIDO (C$)" FontSize="11" FontWeight="SemiBold" Opacity="0.9" />
                    <TextBlock Text="{Binding TotalAmountSold, StringFormat='{}C$ {0:N2}'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Main Editable DataGrid -->
        <materialDesign:Card Grid.Row="2" materialDesign:ElevationAssist.Elevation="Dp1">
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="380">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Código" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProductCode}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Producto" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" Margin="6,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Presentación ComboBox -->
                    <DataGridTemplateColumn Header="Presentación / U.M." Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Presentations}" DisplayMemberPath="Name" 
                                          SelectedItem="{Binding SelectedPresentation, UpdateSourceTrigger=PropertyChanged}" 
                                          Margin="4,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cantidad Enviada -->
                    <DataGridTemplateColumn Header="Cant. Enviada" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QuantitySent, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cantidad Retornada Editable -->
                    <DataGridTemplateColumn Header="Cant. Retornada" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding QuantityReturned, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" 
                                         FontWeight="Bold" Foreground="#C62828" HorizontalContentAlignment="Right" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cantidad Vendida -->
                    <DataGridTemplateColumn Header="Cant. Vendida" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QuantitySold, StringFormat='{}{0:N2}'}" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Precio Venta -->
                    <DataGridTemplateColumn Header="Precio Venta" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SalePrice, StringFormat='{}C$ {0:N2}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Subtotal Vendido -->
                    <DataGridTemplateColumn Header="Subtotal Vendido" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SubtotalSold, StringFormat='{}C$ {0:N2}'}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- General Observations -->
        <TextBox Grid.Row="3" Text="{Binding Observations, UpdateSourceTrigger=PropertyChanged}" 
                 materialDesign:HintAssist.Hint="Observaciones generales de la liquidación de ruta (opcional)" 
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,16,0,0" Height="70" TextWrapping="Wrap" />

        <!-- Actions Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Cancelar" 
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,12,0" Width="120" />

            <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="Confirmar Liquidación" 
                    Command="{Binding ConfirmLiquidationCommand}" Width="200" Background="#8E24AA" BorderBrush="#8E24AA" />
        </StackPanel>
    </Grid>
</UserControl>
